package zone.moddev.mc.iafbopaddon.init;

import net.minecraft.world.item.BlockItem;
import net.minecraft.world.item.Item;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.SoundType;
import net.minecraft.core.registries.BuiltInRegistries;
import net.neoforged.neoforge.registries.DeferredHolder;
import net.neoforged.neoforge.registries.DeferredRegister;

import zone.moddev.mc.ironagefurniture.api.blocks.furniture.BackBench;
import zone.moddev.mc.ironagefurniture.api.blocks.furniture.Bench;
import zone.moddev.mc.ironagefurniture.api.blocks.furniture.BenchNether;
import zone.moddev.mc.ironagefurniture.api.blocks.furniture.Chair;
import zone.moddev.mc.ironagefurniture.api.blocks.furniture.LogBench;
import zone.moddev.mc.ironagefurniture.api.blocks.furniture.Stool;
import zone.moddev.mc.ironagefurniture.api.blocks.furniture.TallStool;
import zone.moddev.mc.ironagefurniture.init.RegistrationProperties;

import java.util.function.Supplier;

public class {{className}} {
	public static final String PERSISTENT_NAMESPACE = "ironagefurniture";
	public static final DeferredRegister<Block> REGISTER = DeferredRegister.create(BuiltInRegistries.BLOCK, PERSISTENT_NAMESPACE);
	public static final DeferredRegister<Item> ITEMS = DeferredRegister.create(BuiltInRegistries.ITEM, PERSISTENT_NAMESPACE);

	private static DeferredHolder<Block, Block> register(String name, Supplier<Block> block) {
		return register(name, block, new Item.Properties());
	}

	private static DeferredHolder<Block, Block> register(String name, Supplier<Block> block, Item.Properties properties) {
		DeferredHolder<Block, Block> registryObject = REGISTER.register(name, block);

		ITEMS.register(name, () -> new BlockItem(registryObject.get(), RegistrationProperties.item(properties, name).useBlockDescriptionPrefix()));

		return registryObject;
	}
